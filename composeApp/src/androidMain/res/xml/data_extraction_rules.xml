<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rule for cloud backup and device-to-device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
