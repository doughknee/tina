<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The pre-Compose window: painted in the theme's ground so the first frame does not flash,
         and the Android 12+ splash uses the launcher icon on the brand colour. -->
    <style name="Theme.Tina" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
